# Kopieer dit bestand naar .env en vul het in:  cp .env.example .env

# --- Algemeen ---
APP_NAME=Declaratietool
ORGANISATION_NAME=Mijn vereniging
# Je domein (zonder https://), gebruikt door Caddy voor het certificaat
DOMAIN=declaraties.example.org
# Volledige adres waarop de tool bereikbaar is (komt in de links in mails)
BASE_URL=https://declaraties.example.org
# Verplicht, minstens 32 tekens. Maak er een met:  openssl rand -hex 32
SECRET_KEY=
DEFAULT_LANGUAGE=nl
TIMEZONE=Europe/Amsterdam
# Voorvoegsel van het kenmerk, bijv. D2026-0001
REFERENCE_PREFIX=D

# --- Database ---
POSTGRES_PASSWORD=

# Mailinstellingen kun je ook later in het portaal invullen (Beheerder > Mailinstellingen);
# die gaan dan vóór de waarden hieronder.
# --- Inkomende mail: het adres waar declaraties naartoe gestuurd worden ---
IMAP_HOST=imap.example.org
IMAP_PORT=993
IMAP_USER=declaraties@example.org
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# --- Uitgaande mail ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=declaraties@example.org
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=declaraties@example.org
# Afzendernaam in mails; leeg = APP_NAME
MAIL_FROM_NAME=

# --- Herinneringen ---
# Uur (lokale tijd) waarop dagelijks herinneringen gaan
REMINDER_HOUR=9
# Hoeveel dagen de indiener herinneringen krijgt om gegevens aan te vullen
SUBMITTER_REMINDER_DAYS=14

# Na hoeveel dagen het logboek (inlogs en binnengekomen mail) wordt opgeschoond; 0 = nooit
LOG_RETENTION_DAYS=90

# Maximale grootte per bijlage in MB
MAX_UPLOAD_MB=15
